FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 RUNTIME_DIR=/app/runtime
WORKDIR /app

COPY requirements-api.txt .
RUN pip install -r requirements-api.txt

COPY src ./src

# Run as a normal user. The runtime folder is created here so the named volume inherits its ownership.
RUN useradd --create-home app && mkdir -p /app/runtime && chown -R app /app/runtime
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "api:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]